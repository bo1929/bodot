theme() {
  # Switch terminal colorscheme everywhere (alacritty + tmux).
  # Usage:
  #   theme              show current theme and available themes
  #   theme <name>       switch to <name> (e.g. gruvbox_dark)
  #   theme toggle       flip current theme dark <-> light
  local script="${HOME}/.config/theme/switch_colorscheme.sh"
  local conf="${HOME}/.config/theme/colorschemes.toml"
  local dir="${HOME}/.config/theme/themes"

  local current
  current=$(grep -o '[^"/]*\.toml' "${conf}" 2>/dev/null | tail -1 | sed 's/\.toml$//')

  if [[ $# -eq 0 ]]; then
    echo "current: ${current:-<none>}"
    echo "available:"
    ls "${dir}" | sed 's/\.toml$//'
    return 0
  fi

  local name="$1"
  if [[ "${name}" == "toggle" ]]; then
    case "${current}" in
      *_dark)  name="${current%_dark}_light" ;;
      *_light) name="${current%_light}_dark" ;;
      *) echo "theme: don't know how to toggle '${current}'" >&2; return 1 ;;
    esac
    if [[ ! -f "${dir}/${name}.toml" ]]; then
      echo "theme: no counterpart '${name}' for '${current}'" >&2; return 1
    fi
  fi

  "${script}" "${name}"

  # Keep the autosuggestion ghost text dim for the new variant.
  case "${name}" in
    *light*) ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#bdae93' ;;
    *)       ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#665c54' ;;
  esac
}
